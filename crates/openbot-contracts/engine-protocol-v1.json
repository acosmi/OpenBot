{
  "schema": "openbot-engine-protocol",
  "version": 1,
  "release_epoch": 1,
  "max_boot_bytes": 4096,
  "max_control_frame_bytes": 65536,
  "max_image_bytes": 8388608,
  "frame_magic": "OBFRAME1",
  "frame_hello_magic": "OBFHELLO",
  "frame_fixed_header_bytes": 48,
  "roles": [
    "browser_computer",
    "sandboxed_component"
  ],
  "commands": [
    "start",
    "stop",
    "shutdown"
  ],
  "events": [
    "hello",
    "ready",
    "started",
    "stopped",
    "shutdown_complete",
    "error"
  ],
  "image_formats": [
    "jpeg"
  ]
}
